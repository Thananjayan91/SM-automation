# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_social_publisher

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / Object Storage
S3_BUCKET=ai-social-publisher-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT_URL=

# Encryption
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-fernet

# AI Providers (add when needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://yourdomain.com/api/v1/integrations/meta/callback

# Admin
PLATFORM_ADMIN_SECRET=change-me-admin-bootstrap-token

# Rate limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/2
