[Unit]
Description=AI Social Publisher — Celery Worker
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-social-publisher/backend
Environment="PATH=/opt/ai-social-publisher/.venv/bin"
EnvironmentFile=/opt/ai-social-publisher/.env
ExecStart=/opt/ai-social-publisher/.venv/bin/celery \
    -A worker.celery worker \
    --loglevel=info \
    --concurrency=2 \
    --logfile=/var/log/ai-social-publisher/celery.log
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

